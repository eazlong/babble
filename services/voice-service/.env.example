ELEVENLABS_API_KEY=<your-key>

# F5-TTS (local MLX server, runs on Mac via: .venv/bin/python services/f5-tts-server/main.py)
FISH_SPEECH_URL=http://localhost:8002

# Local Whisper ASR (faster-whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE=/models/whisper

# XFYUN (iFlytek) Voice Service
# Get credentials from: https://www.xfyun.cn/
XFYUN_APP_ID=<your-app-id>
XFYUN_API_KEY=<your-api-key>
XFYUN_API_SECRET=<your-api-secret>

# Voice Service Mode
# test = Xfyun first (for testing environment)
# production = Whisper/Fish first (for production environment)
VOICE_SERVICE_MODE=production

# ASR Post-process（纠错 / 槽位抽取 / 目标意图判定）走 OpenAI 兼容接口
# 注意：BASE_URL 必须包含 /v1。少了它，请求会打到网关站点首页并拿到 HTML（HTTP 200），
# SDK 于是返回 str，意图判定会**全程静默降级**（每个请求都 fallback_reason=provider_error，
# 客户端退回 corrected_text）；启动探针会直接报 ERROR 并给出响应预览。
# 背景见 docs/plans/2026-09-15-intent-accuracy.md §11.3 / §15
ASR_POSTPROCESS_BASE_URL=https://your-gateway.example.com/v1
ASR_POSTPROCESS_API_KEY=<your-key>
ASR_POSTPROCESS_MODEL=<model-id>
# ASR_POSTPROCESS_ENABLED=true
# ASR_POSTPROCESS_TIMEOUT_MS=30000
# ASR_POSTPROCESS_MAX_TOKENS=2048
# 启动/健康检查探针的预算（毫秒）。探针只发一个极小请求，用于在启动时喊出 provider 故障；
# 结果暴露在 GET /health 的 postprocess 字段，加 ?probe=1 可手动重跑。
# ASR_POSTPROCESS_PROBE_TIMEOUT_MS=10000

# 改完本文件后：容器必须 **recreate**（docker compose up -d --force-recreate voice-service）——
# `docker restart` 不会重读 env_file，配置不会生效。
# 改 src/ 下的代码则只需重启容器（src 是只读挂载，但 uvicorn 未开 --reload）。

# 意图判定评测（可选）：设 1 才会跑真实模型的评测用例（消耗预算）
# INTENT_EVAL_LIVE=1
