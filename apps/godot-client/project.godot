; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="LinguaQuest RPG"
run/main_scene="res://assets/scenes/BeginningFP.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

UIFramework="*res://assets/scripts/ui/framework/ui_framework.gd"
SaveSystem="*res://assets/scripts/core/save_system.gd"
MagicEchoManager="*res://assets/scripts/autoload/MagicEchoManager.gd"
GameManager="*res://assets/scripts/autoload/GameManager.gd"
SceneManagementSystem="*res://assets/scripts/core/scene_management_system.gd"
HybridAPI="*res://assets/scripts/autoload/HybridAPI.gd"
VoicePipeline="*res://assets/scripts/autoload/VoicePipeline.gd"
DialogueManager="*res://assets/scripts/autoload/DialogueManager.gd"
AudioManager="*res://assets/scripts/autoload/AudioManager.gd"
DialogueBox="*res://assets/scripts/autoload/DialogueBox.gd"
CoachClient="*res://assets/scripts/autoload/CoachClient.gd"
QuestWebSocket="*res://assets/scripts/autoload/QuestWebSocket.gd"
SpiritDatabase="*res://assets/scripts/autoload/SpiritDatabase.gd"
SpiritCollectionManager="*res://assets/scripts/autoload/SpiritCollectionManager.gd"
PerformanceMonitor="*res://assets/scripts/components/PerformanceMonitor.gd"
VFXManager="*res://assets/scripts/autoload/VFXManager.gd"
UITweenManager="*res://assets/scripts/autoload/UITweenManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[game]

test_mode_skip_auto_load_save=false

[gui]

theme/custom="res://assets/resources/fonts/ChineseTheme.tres"

[hybrid_api]

asr_default_answer_test_enabled=true
asr_test_audio_dir="res://assets/test_audio/"
; 玩家台词的轮换由各场景自己声明（见 BeginningFPController / MirageInnIntroductionController
; / ChangAnMarketController 的 TEST_ASR_* 与 scene_config 的 test_asr_audio_names）。
; 这里只给一个启动前的占位：全局顺序没法同时满足"从序章开始玩"和"带存档续到某个场景"，
; 曾经因此把序章的名字答案喂给了"唤醒书架"（孩子怎么说都过不去）。
; 注意别留空——空列表会让收集逻辑退化成"把 test_audio 下所有 wav 都排进来"。
asr_test_audio_names=PackedStringArray("pa_01_prologue_source_name.wav")
recorded_tts_enabled=true
recorded_tts_dir="res://assets/test_audio/tts/"

[input]

move_left={
"deadzone": 0.5,
